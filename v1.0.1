local function computeStrikeCFrame(targetHrp)
    local vel = targetHrp.AssemblyLinearVelocity
    local flatVel = Vector3.new(vel.X, 0, vel.Z)
    local predictedPos = targetHrp.Position + (flatVel * LEAD_TIME)

    local moveDir = flatVel.Magnitude > 1 and flatVel.Unit or targetHrp.CFrame.LookVector
    local strikePos = predictedPos - (moveDir * BEHIND_OFFSET) + Vector3.new(0, 0.25, 0)

    return CFrame.lookAt(strikePos, predictedPos)
end

local function startStickPhase(targetHrp)
    if activeStickConn then
        activeStickConn:Disconnect()
        activeStickConn = nil
    end

    local startTime = os.clock()
    activeStickConn = RunService.Heartbeat:Connect(function()
        if not isTpSkillEnabled or not hrp or not hrp.Parent or not targetHrp or not targetHrp.Parent then
            if activeStickConn then
                activeStickConn:Disconnect()
                activeStickConn = nil
            end
            return
        end

        if (os.clock() - startTime) >= STICK_DURATION then
            activeStickConn:Disconnect()
            activeStickConn = nil
            return
        end

        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = computeStrikeCFrame(targetHrp)
    end)
end

local function tpToTargetForHit()
    if not isTpSkillEnabled or not hrp or not hrp.Parent then return end

    local _, targetHrp = getTargetPlayer()
    if not targetHrp then return end

    local dist = (targetHrp.Position - hrp.Position).Magnitude
    if dist > MAX_TWEEN_RANGE then
        return
    end

    stopActiveMotion()
    hrp.AssemblyLinearVelocity = Vector3.zero

    local goalCf = computeStrikeCFrame(targetHrp)

    -- Chỉ tween khi khoảng cách nằm trong phạm vi [MIN_TWEEN_RANGE, MAX_TWEEN_RANGE]
    if dist >= MIN_TWEEN_RANGE and dist <= MAX_TWEEN_RANGE then
        local tweenDuration = math.clamp(dist / TWEEN_SPEED, MIN_TWEEN_TIME, MAX_TWEEN_TIME)
        local info = TweenInfo.new(tweenDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tween = TweenService:Create(hrp, info, { CFrame = goalCf })
        activeTween = tween

        tween.Completed:Connect(function(playbackState)
            if activeTween == tween then
                activeTween = nil
            end
            if playbackState == Enum.PlaybackState.Completed and isTpSkillEnabled and hrp and hrp.Parent and targetHrp and targetHrp.Parent then
                startStickPhase(targetHrp)
            end
        end)

        tween:Play()
    else
        -- Gần hơn MIN_TWEEN_RANGE thì đặt thẳng vào vị trí đánh và bám dính luôn
        hrp.CFrame = goalCf
        startStickPhase(targetHrp)
    end
end

local function isPointInsideGui(guiObj, pos)
    if not guiObj or not guiObj.Visible then return false end
    local absPos = guiObj.AbsolutePosition
    local absSize = guiObj.AbsoluteSize
    return pos.X >= absPos.X and pos.X <= (absPos.X + absSize.X)
        and pos.Y >= absPos.Y and pos.Y <= (absPos.Y + absSize.Y)
end

local function isClickingOwnUi(pos)
    if isPointInsideGui(uiRefs.Icon, pos) then
        return true
    end
    if isPointInsideGui(uiRefs.Main, pos) then
        return true
    end
    return false
end

local function matchesAllowedAbility(rawStr)
    local norm = normalizeAbilityName(rawStr)
    if norm == "" then return false end
    if ALLOWED_ABILITIES[norm] then
        return true
    end
    for abilityNorm in pairs(ALLOWED_ABILITIES) do
        if string.find(norm, abilityNorm, 1, true) then
            return true
        end
    end
    return false
end

local function isValidAbilityButton(btn)
    if not btn or not btn:IsA("GuiButton") then return false end
    if currentScreenGui and btn:IsDescendantOf(currentScreenGui) then return false end

    local sg = btn:FindFirstAncestorOfClass("ScreenGui")
    if not sg or not sg.Enabled then
        return false
    end

    if matchesAllowedAbility(btn.Name) then
        return true
    end

    if btn.Parent and matchesAllowedAbility(btn.Parent.Name) then
        return true
    end

    if btn:IsA("TextButton") and matchesAllowedAbility(btn.Text) then
        return true
    end

    for _, child in ipairs(btn:GetDescendants()) do
        if (child:IsA("TextLabel") or child:IsA("TextButton")) and matchesAllowedAbility(child.Text) then
            return true
        end
        if matchesAllowedAbility(child.Name) then
            return true
        end
    end

    return false
end

local function hookAbilityButton(btn)
    if hookedButtons[btn] or not isValidAbilityButton(btn) then return end
    hookedButtons[btn] = true

    btn.InputBegan:Connect(function(input)
        if not isTpSkillEnabled then return end
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            tpToTargetForHit()
        end
    end)
end

local function scanAbilityButtons()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return end
    for _, obj in ipairs(pg:GetDescendants()) do
        if obj:IsA("GuiButton") then
            hookAbilityButton(obj)
        end
    end
end

local function bindDrag(handle, targetFrame, onTap)
    local dragging = false
    local dragStart = nil
    local startPos = nil
    local activeInput = nil

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            activeInput = input
            dragStart = input.Position
            startPos = targetFrame.Position
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input == activeInput and dragging then
            local delta = input.Position - dragStart
            targetFrame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    handle.InputEnded:Connect(function(input)
        if input == activeInput then
            local movedDist = dragStart and (input.Position - dragStart).Magnitude or 0
            dragging = false
            activeInput = nil
            if onTap and movedDist < 8 then
                onTap()
            end
        end
    end)
end

