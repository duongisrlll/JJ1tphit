conns[1] = LP.CharacterAdded:Connect(onCharacterAdded)

conns[2] = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not isTpSkillEnabled then return end
    if UserInputService:GetFocusedTextBox() then return end

    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if detectedPlatform == "PC" and not gameProcessed and not isClickingOwnUi(input.Position) then
            tpToTargetForHit()
        end
        return
    end

    if gameProcessed then return end

    if input.UserInputType == Enum.UserInputType.Keyboard or input.UserInputType == Enum.UserInputType.Gamepad1 then
        local keyName = string.lower(input.KeyCode.Name)
        if SKILL_KEYS[keyName] then
            tpToTargetForHit()
        end
    end
end)

