local function stopActiveMotion()
    if activeStickConn then
        activeStickConn:Disconnect()
        activeStickConn = nil
    end
    if activeTween then
        pcall(function() activeTween:Cancel() end)
        activeTween = nil
    end
end

local function getTargetPlayer()
    if not hrp then return nil, nil end

    if selectedTargetUserId then
        local plr = Players:GetPlayerByUserId(selectedTargetUserId)
        if plr and plr ~= LP and plr.Character then
            local tHrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local tHum = plr.Character:FindFirstChildOfClass("Humanoid")
            if tHrp and tHum and tHum.Health > 0 then
                local dist = (tHrp.Position - hrp.Position).Magnitude
                if dist <= MAX_TWEEN_RANGE then
                    return plr, tHrp
                end
            end
        end
    end

    local closestPlr = nil
    local closestHrp = nil
    local bestDist = MAX_TWEEN_RANGE

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local tHrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local tHum = plr.Character:FindFirstChildOfClass("Humanoid")
            if tHrp and tHum and tHum.Health > 0 then
                local dist = (tHrp.Position - hrp.Position).Magnitude
                if dist <= bestDist then
                    bestDist = dist
                    closestPlr = plr
                    closestHrp = tHrp
                end
            end
        end
    end

    return closestPlr, closestHrp
end

